{
    "expo":  {
                 "name":  "Stocks",
                 "slug":  "stocksapp",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/real-icon.png",
                 "userInterfaceStyle":  "light",
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier": "com.deveshgoyal.stocksapp"
                         },
                 "android":  {
                                 "softwareKeyboardLayoutMode":  "pan",
                                 "statusBar":  {
                                                   "barStyle":  "dark-content",
                                                   "backgroundColor":  "#00000000",
                                                   "translucent":  true
                                               },
                                 "navigationBar":  {
                                                       "backgroundColor":  "#FFFFFF",
                                                       "barStyle":  "dark-content"
                                                   },
                                 "package":  "com.stocksapp.clone",
                                 "predictiveBackGestureEnabled":  false
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png"
                         },
                 "extra":  {
                               "eas":  {
                                           "projectId":  "644576c0-d0b9-4cd8-9dcd-b7b171ff83ee"
                                       }
                           },
                 "owner":  "deveshgoyal",
                 "plugins":  [
                                 "expo-font",
                                 [
                                     "expo-status-bar",
                                     {
                                         "style":  "dark",
                                         "backgroundColor":  "#00000000"
                                     }
                                 ],
                                 "./withBlankSplash.js"
                             ],
                 "splash":  {
                                "backgroundColor":  "#ffffff",
                                "image":  "./assets/transparent.png",
                                "resizeMode":  "contain"
                            }
             }
}
